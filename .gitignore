# ============================================================
#  HRB_Transdiff — .gitignore
#  This repository tracks CODE ONLY. Raw microscopy data, bundled
#  conda environments, and generated outputs are excluded and live
#  on local disk / data backup (see README). Rebuild envs from
#  environment.yml, not from committed binaries.
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.ipynb_checkpoints/

# --- Bundled environments (NEVER commit — 4.8 GB of torch/CUDA) ---
Conversion_Efficiency/cpenv/
**/cpenv/
**/venv/
**/.venv/
**/site-packages/

# --- Q_Plates: ignore the raw data, but KEEP the small hand-label files ---
#     (irreplaceable ROI zips + Results CSVs + analysis scripts, ~2 MB total)
Q_PLATES/**
!Q_PLATES/**/
!Q_PLATES/**/*_ROIs.zip
!Q_PLATES/**/*_Results*.csv
!Q_PLATES/**/*.R
!Q_PLATES/**/*_summary.csv
# never the raws, even via a re-included directory
Q_PLATES/**/*.nd2
Q_PLATES/**/*.tif
Q_PLATES/**/*.tiff

# --- Raw microscopy data anywhere ---
*.nd2

# --- Large image/volume binaries ---
*.tif
*.tiff

# --- Generated analysis outputs ---
ClaudeOutputs/
outputs/
Conversion_Efficiency/cp_c08_full/
Conversion_Efficiency/cp_c08_crop/
Conversion_Efficiency/outputs/
Conversion_Efficiency/outputs_B02/

# --- Pipeline run outputs (4.1 GB, regenerable) ---
#     ...but KEEP the human-review label files, which are precious.
MyotubePipeline/runs/**
!MyotubePipeline/runs/**/
!MyotubePipeline/runs/**/decisions.json

# --- Large regenerable renders ---
MyotubePipeline/linker/overlays/

# --- PrecisionMyotube regenerable runs / annotation workspace ---
PrecisionMyotube/runs/
PrecisionMyotube/annotation_work/
PrecisionMyotube/.pytest_tmp/

# --- Nested / experimental temp repo ---
.codex_tmp_repo/

# --- Cleanup 2026-08 additions (see cleanup_2026-08/ACTION_LOG.md) ---
# Regenerable Conversion_Efficiency result folders (masks, overlays, run logs)
Conversion_Efficiency/plate*_nuclei/
Conversion_Efficiency/plate*_myotube/
Conversion_Efficiency/plate*_fusion/
Conversion_Efficiency/plate*_real_fusion/
Conversion_Efficiency/Plate9_C6C2_QTFCs/
Conversion_Efficiency/*.zip
Conversion_Efficiency/New_Quantif_*/dbs_cache/
Conversion_Efficiency/New_Quantif_*/myotube/
Conversion_Efficiency/New_Quantif_*/nuclei/
# well-prefixed per-well overlay renders (regenerable; summary figures are kept)
Conversion_Efficiency/New_Quantif_*/[0-9]*_*.png
Conversion_Efficiency/New_Quantif_Benchmark/myotube*/
# dead proof-of-loop artifacts (quarantine pending user ruling)
model_labs/_proof/
# Binary array dumps (regenerable masks/caches)
*.npy
*.npz
# Scratch trees and build artifacts
tmp/
output/
model_labs/**/_runs/
# Nested git clone — pin upstream by commit SHA in competitors/MyoFuse/NOTICE.md instead
competitors/MyoFuse/upstream/

# --- Logs ---
*.log
*.err

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini
